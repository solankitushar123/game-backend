# Copy this file to .env and fill in real values before deploying.
# Never commit the actual .env file.

APP_NAME=ArenaForge
ENV=production

# MySQL connection string
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/gamejackpot

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# JWT — generate a real random 256-bit secret for production, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_256_BIT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["https://yourdomain.com", "http://localhost:5173"]

# Business rules
MIN_DEPOSIT_PAISE=1000
MAX_DEPOSIT_PAISE=10000000
MIN_AGE_YEARS=18

# Payment gateway mode — 'simulated' for dev/demo, swap for 'razorpay'/'cashfree' integration in production
PAYMENT_GATEWAY_MODE=simulated
